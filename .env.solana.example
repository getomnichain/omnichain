# Copy to .env.solana.local (git-ignored) for `npm run test:live:solana`. Mainnet, read-only: it only simulates.

# An RPC that serves simulateBundle (publicnode, Helius, Alchemy). Defaults to publicnode.
SOLANA_LIVE_BUNDLE_RPC_URL=https://solana-rpc.publicnode.com

# A keyed Ankr URL (https://rpc.ankr.com/solana/<key>), which does not serve simulateBundle. Optional: its check is skipped when empty.
SOLANA_LIVE_ANKR_RPC_URL=

# A funded system account to pay for the simulated transfers. Nothing is signed or sent. Defaults to a large public wallet.
SOLANA_LIVE_FUNDER=
